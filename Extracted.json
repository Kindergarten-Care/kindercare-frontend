U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"d73f3b4e-6afe-4c2d-8f00-36c97d7540d8\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"05f78a27-20b1-4e5c-903a-bf4a5d509db8\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n*{box-sizing:border-box;}\nhtml,body{margin:0;padding:0;}\nbody{font-family:'Inter',system-ui,sans-serif;background:#E9F1EC;color:#1F2937;-webkit-font-smoothing:antialiased;}\n.display{font-family:'Plus Jakarta Sans','Inter',sans-serif;}\n::-webkit-scrollbar{width:8px;height:8px;}\n::-webkit-scrollbar-thumb{background:#cfe0d6;border-radius:8px;}\n.kc-rail{transition:background .15s,color .15s;}\n.kc-rail:hover{background:#E6F3ED;color:#005A36;}\n.kc-card{transition:transform .2s cubic-bezier(.4,0,.2,1),box-shadow .2s;}\n.kc-card:hover{transform:translateY(-3px);box-shadow:0 18px 44px -16px rgba(0,90,54,.22) !important;}\n.kc-chip{transition:background .15s,border-color .15s,color .15s;}\n.kc-up:hover{background:#005A36 !important;color:#fff !important;border-color:#005A36 !important;}\n@keyframes kc-laser{0%{top:8%;opacity:0;}15%{opacity:.9;}85%{opacity:.9;}100%{top:88%;opacity:0;}}\n@keyframes kc-corner{0%,100%{opacity:1;}50%{opacity:.35;}}\n@keyframes kc-shimmer{0%{background-position:-400px 0;}100%{background-position:400px 0;}}\n@keyframes kc-slidedown{from{opacity:0;transform:translateY(-16px) scale(.98);}to{opacity:1;transform:none;}}\n@keyframes kc-alertpulse{0%,100%{box-shadow:0 0 0 0 rgba(220,38,38,0);}45%{box-shadow:0 0 0 5px rgba(220,38,38,.28);}}\n@keyframes kc-toastin{from{opacity:0;transform:translateY(20px) scale(.92);}to{opacity:1;transform:none;}}\n@keyframes kc-fadeout{to{opacity:0;transform:scale(.9) translateX(20px);}}\n@keyframes kc-flash{0%{opacity:0;}25%{opacity:1;}100%{opacity:0;}}\n@keyframes kc-ripple{0%{transform:scale(.6);opacity:.55;}100%{transform:scale(2.4);opacity:0;}}\n@keyframes kc-pop{from{opacity:0;transform:scale(.85) translateY(10px);}to{opacity:1;transform:none;}}\n@keyframes kc-starpop{0%{transform:scale(1);}40%{transform:scale(1.4) rotate(14deg);}100%{transform:scale(1);}}\n@keyframes kc-overlay{from{opacity:0;}to{opacity:1;}}\n@keyframes kc-modalin{from{opacity:0;transform:translateY(16px) scale(.96);}to{opacity:1;transform:none;}}\n@keyframes kc-bob{0%,100%{transform:translateY(0) rotate(-4deg);}50%{transform:translateY(-10px) rotate(3deg);}}\n@media(max-width:1180px){.kc-body{flex-direction:column !important;}.kc-right{width:auto !important;}.kc-modalbody{grid-template-columns:1fr !important;}}\n@media(max-width:720px){.kc-cards{grid-template-columns:repeat(2,1fr) !important;}}\n.kc-sb{width:262px;}\n.kc-main{margin-left:262px;}\n.kc-navitem{transition:background .15s,color .15s;}\n.kc-navitem:hover{background:rgba(255,255,255,.1);}\n.kc-navitem.kc-active:hover{background:#fff;}\nbody.kc-collapsed .kc-sb{width:88px !important;}\nbody.kc-collapsed .kc-main{margin-left:88px !important;}\nbody.kc-collapsed .kc-label,body.kc-collapsed .kc-sect,body.kc-collapsed .kc-fullonly,body.kc-collapsed .kc-badge{display:none !important;}\nbody.kc-collapsed .kc-navitem{justify-content:center !important;padding-left:0 !important;padding-right:0 !important;}\nbody.kc-collapsed .kc-logo,body.kc-collapsed .kc-profile,body.kc-collapsed .kc-userbar{justify-content:center !important;padding-left:8px !important;padding-right:8px !important;}\nbody.k