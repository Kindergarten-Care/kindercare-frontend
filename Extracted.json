id #EEF4F0;\">\n        <span style=\"flex:none;width:42px;height:42px;border-radius:12px;background:#005A36;color:#fff;display:flex;align-items:center;justify-content:center;\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"><\u002Frect><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"><\u002Frect><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"><\u002Frect><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"><\u002Frect><\u002Fsvg><\u002Fspan>\n        <div style=\"flex:1;\"><div class=\"display\" style=\"font-size:18px;font-weight:800;letter-spacing:-.01em;\">Tất cả chức năng<\u002Fdiv><div style=\"font-size:13px;color:#9CA3AF;font-weight:500;\">Chọn nhanh công cụ bạn cần<\u002Fdiv><\u002Fdiv>\n        <button onclick=\"{{ closeAllFns }}\" style=\"flex:none;width:40px;height:40px;border-radius:12px;border:1px solid #E6EEE9;background:#fff;color:#6B7280;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;\" style-hover=\"background:#F6FAF7;color:#DC2626;\">✕<\u002Fbutton>\n      <\u002Fdiv>\n      <div style=\"padding:20px 22px 24px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px;\">\n        <sc-for list=\"{{ allFns }}\" as=\"f\" hint-placeholder-count=\"9\">\n          <button onclick=\"{{ f.action }}\" class=\"kc-card\" style=\"display:flex;flex-direction:column;align-items:flex-start;gap:11px;padding:16px;border-radius:16px;border:1px solid #EEF4F0;background:#FAFCFB;cursor:pointer;text-align:left;\">\n            <span style=\"flex:none;width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:19px;background:{{ f.tint }};color:{{ f.color }};\">{{ f.icon }}<\u002Fspan>\n            <span class=\"display\" style=\"font-size:13.5px;font-weight:700;color:#1F2937;line-height:1.3;\">{{ f.label }}<\u002Fspan>\n          <\u002Fbutton>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<!-- REQUESTS MODAL -->\n<sc-if value=\"{{ requestsOpen }}\" hint-placeholder-val=\"{{ false }}\">\n  <div onclick=\"{{ closeRequests }}\" style=\"position:fixed;inset:0;z-index:9200;background:rgba(15,30,22,.5);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:24px;animation:kc-overlay .2s ease;\">\n    <div onclick=\"{{ stop }}\" style=\"width:min(540px,100%);max-height:88vh;overflow:auto;background:#fff;border-radius:22px;box-shadow:0 32px 80px -20px rgba(0,0,0,.4);animation:kc-modalin .25s cubic-bezier(.2,.8,.3,1);\">\n      <div style=\"display:flex;align-items:center;gap:13px;padding:20px 24px;border-bottom:1px solid #EEF4F0;\">\n        <span style=\"flex:none;width:42px;height:42px;border-radius:12px;background:#005A36;color:#fff;display:flex;align-items:center;justify-content:center;\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"><\u002Fpath><\u002Fsvg><\u002Fspan>\n        <div style=\"flex:1;\"><div class=\"display\" style=\"font-size:18px;font-weight:800;letter-spacing:-.01em;\">Yêu cầu từ phụ huynh<\u002Fdiv><div style=\"font-size:13px;color:#9CA3AF;font-weight:500;\">{{ requestCount }} yêu cầu cần phản hồi<\u002Fdiv><\u002Fdiv>\n        <button onclick=\"{{ closeRequests }}\" style=\"flex:none;width:40px;height:40px;border-radius:12px;border:1px solid #E6EEE9;background:#fff;color:#6B7280;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;\" style-hover=\"background:#F6FAF7;color:#DC2626;\">✕<\u002Fbutton>\n      <\u002Fdiv>\n      <div style=\"padding:18px 22px 22px;display:flex;flex-direction:column;gap:11px;\">\n        <sc-for list=\"{{ requests }}\" as=\"q\" hint-placeholder-count=\"2\">\n          <div style=\"{{ q.rowStyle }}\">\n            <span style=\"flex:none;width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;color:#374151;background:{{ q.color }};\" class=\"display\">{{ q.initial }}<\u002Fspan>\n            <div style=\"flex:1;min-width:0;\">\n              <div style=\"display:flex;align-items:center;gap:7px;\"><span class=\"display\" style=\"font-weight:700;font-size:13.5px;color:#1F2937;\">{{ q.name }}<\u002Fspan><span style=\"{{ q.tagStyle }}\">{{ q.tag }}<\u002Fspan><\u002Fdiv>\n              <div style=\"font-size:12.5px;color:#6B7280;margin-top:3px;line-height:1.5;\">{{ q.msg }}<\u002Fdiv>\n            <\u002Fdiv>\n            <button onclick=\"{{ q.resolve }}\" class=\"kc-up\" style=\"flex:none;align-self:flex-start;height:34px;padding:0 14px;border-radius:10px;border:1px solid #C7E3D5;background:#fff;color:#005A36;font-family:inherit;font-weight:700;font-size:12.5px;cursor:pointer;transition:all .15s;\">Phản hồi<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n        <sc-if value=\"{{ noRequests }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"padding:24px;border-radius:14px;background:#E6F3ED;border:1px dashed #C7E3D5;text-align:center;font-size:13.5px;font-weight:600;color:#005A36;\">✅ Đã phản hồi tất cả yêu cầu!<\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<!-- TOASTS -->\n<div style=\"position:fixed;left:50%;bottom:28px;transform:translateX(-50%);z-index:9500;display:flex;flex-direction:column;gap:10px;align-items:center;pointer-events:none;\">\n  <sc-for list=\"{{ toasts }}\" as=\"t\" hint-placeholder-count=\"0\">\n    <div class=\"display\" style=\"display:flex;align-items:center;gap:10px;padding:13px 20px;border-radius:14px;background:#005A36;color:#fff;font-size:13.5px;font-weight:600;box-shadow:0 18px 48px -12px rgba(0,90,54,.4);animation:kc-toastin .3s cubic-bezier(.2,.8,.3,1);max-width:360px;\">{{ t.text }}<\u002Fdiv>\n  <\u002Fsc-for>\n<\u002Fdiv>\n\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1320,&quot;height&quot;:920},&quot;soundOn&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;}}\">\nclass Component extends DCLogic {\n  av = (name) => {\n    const palette = ['#FCA5A5','#FCD34D','#6EE7B7','#93C5FD','#C4B5FD','#F9A8D4','#FDBA74','#67E8F9','#A5B4FC','#5EEAD4'];\n    const p = name.trim().split(' ');\n    const initial = p[p.length - 1][0].toUpperCase();\n    let h = 0;\n    for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0;\n    return { initial, color: palette[h % palette.length] };\n  };\n  fn = (name) => name.trim().split(' ').slice(-1)[0];\n  stop = (e) => { if (e) e.stopPropagation(); };\n\n  queue = [\n    { name: 'Gia Bảo', note: null },\n    { name: 'Bảo Long', note: 'Dị ứng đậu phộng — nghiêm trọng, tránh món lạ' },\n    { name: 'Thảo My', note: null },\n    { name: 'Hải Anh', note: 'Sốt nhẹ 37.5°, theo dõi thêm' },\n    { name: 'Đức Anh', note: null },\n    { name: 'Phương Vy', note: null },\n    { name: 'Tuấn Kiệt', note: 'Ho nhiều, nhắc uống nước ấm' },\n    { name: 'Bảo Ngọc', note: null },\n  ];\n\n  nid = 100;\n  kidNames = ['Minh Khôi','Khánh Linh','An Nhiên','Gia Huy'];\n\n  state = {\n    loading: true,\n    present: 24,\n    scannerOpen: false,\n    cat: 'attend',\n    liveFeed: [\n      { id: 'lf1', name: 'Minh Khôi', time: '07:31', note: null },\n      { id: 'lf2', name: 'Khánh Linh', time: '07:33', note: null },\n    ],\n    scanFlash: false, scanAlert: false, queueIdx: 0,\n    medical: [\n      { id: 'm1', name: 'Bé Khang', med: 'Siro ho Prospan · 5ml', done: false },\n      { id: 'm2', name: 'Bé Bảo Long', med: 'Kháng dị ứng · sau ăn', done: false },\n    ],\n    leaves: [\n      { id: 'r1', name: 'Bé Phương Vy', reason: 'Bị ốm, sốt · hôm nay', removing: false },\n      { id: 'r2', name: 'Bé Gia Hân', reason: 'Việc gia đình · 2 ngày', removing: false },\n    ],\n    featured: [\n      { id: 'f1', name: 'Minh Khôi', days: 5, meals: 5 },\n      { id: 'f2', name: 'An Nhiên', days: 5, meals: 4 },\n      { id: 'f3', name: 'Khánh Linh', days: 4, meals: 4 },\n      { id: 'f4', name: 'Gia Huy', days: 5, meals: 3 },\n    ],\n    awarded: {},\n    toasts: [],\n    notifOpen: false, avatarOpen: false,\n    requestsOpen: false,\n    allFnsOpen: false,\n    requests: [\n      { id: 'q1', name: 'Mẹ bé Khang', tag: 'Dặn dò', msg: 'Bé hơi ho, nhờ cô cho uống siro lúc 11h và để ý thêm giúp em ạ.', kind: 'note' },\n      { id: 'q2', name: 'Ba bé Phương Vy', tag: 'Đón sớm', msg: 'Hôm nay nhà có việc, em xin đón bé Vy lúc 15:30 ạ.', kind: 'pickup' },\n    ],\n  };\n\n  catDefs = [\n    { key: 'attend', label: 'Điểm danh', icon: '✓', color: '#005A36', tint: '#E6F3ED' },\n    { key: 'activity', label: 'Hoạt động', icon: '🎨', color: '#2563EB', tint: '#E3EDFD' },\n    { key: 'health', label: 'Y tế', icon: '💊', color: '#DC2626', tint: '#FEE2E2' },\n    { key: 'reward', label: 'Phiếu bé ngoan', icon: '⭐', color: '#D97706', tint: '#FEF3C7' },\n    { key: 'leave', label: 'Đơn phép', icon: '📩', color: '#8B5CF6', tint: '#F1ECFE' },\n  ];\n\n  componentDidMount() {\n    setTimeout(() => this.setState({ loading: false }), 1000);\n    this._docClick = () => this.setState(s => (s.notifOpen || s.avatarOpen) ? { notifOpen: false, avatarOpen: false } : null);\n    document.addEventListener('click', this._docClick);\n    this._key = (e) => { if (e.key === 'Escape') this.setState({ scannerOpen: false }); };\n    document.addEventListener('keydown', this._key);\n  }\n  componentWillUnmount() { document.removeEventListener('click', this._docClick); document.removeEventListener('keydown', this._key); }\n\n  now() { const d = new Date(); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }\n  ensureAudio() { if (!this._actx) { try { this._actx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} } return this._actx; }\n  playTing() {\n    if (this.props.soundOn === false) return;\n    const ctx = this.ensureAudio(); if (!ctx) return;\n    if (ctx.state === 'suspended') ctx.resume();\n    const t = ctx.currentTime;\n    [880, 1318.5].forEach((f, i) => { const o = ctx.createOscillator(), g = ctx.createGain(); o.type = 'sine'; o.frequency.value = f; const st = t + i * 0.085; g.gain.setValueAtTime(0, st); g.gain.linearRampToValueAtTime(0.16, st + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, st + 0.32); o.connect(g).connect(ctx.destination); o.start(st); o.stop(st + 0.34); });\n  }\n\n  addToast = (text) => {\n    const id = 't' + (this.nid++);\n    this.setState(s => ({ toasts: [...s.toasts, { id, text }] }));\n    setTimeout(() => this.setState(s => ({ toasts: s.toasts.filter(t => t.id !== id) })), 3000);\n  };\n\n  burst(x, y, colors) {\n    const layer = this.confetti; if (!layer) return;\n    const cs = colors || ['#005A36','#34D399','#FCD34D','#DC2626','#93C5FD','#C4B5FD'];\n    for (let i = 0; i < 22; i++) {\n      const s = document.createElement('span'); const c = cs[i % cs.length];\n      s.style.cssText = 'position:fixed;left:' + x + 'px;top:' + y + 'px;width:8px;height:8px;border-radius:2px;background:' + c + ';z-index:99999;';\n      layer.appendChild(s);\n      const ang = Math.random() * Math.PI * 2; const dist = 40 + Math.random() * 80;\n      const dx = Math.cos(ang) * dist; const dy = Math.sin(ang) * dist - 30;\n      s.animate([{ transform: 'translate(0,0) rotate(0)', opacity: 1 }, { transform: 'translate(' + dx + 'px,' + (dy + 100) + 'px) rotate(' + (Math.random() * 540) + 'deg)', opacity: 0 }], { duration: 700 + Math.random() * 350, easing: 'cubic-bezier(.2,.6,.4,1)' }).onfinish = () => s.remove();\n    }\n  }\n\n  openScanner = () => this.setState({ scannerOpen: true });\n  closeScanner = () => this.setState({ scannerOpen: false });\n  setCat = (k) => { this.setState({ cat: k }); };\n  onCat = (k) => {\n    this.setState({ cat: k });\n    if (k === 'attend') { this.openScanner(); return; }\n    if (k === 'leave') { this.setState({ requestsOpen: true }); return; }\n    if (k === 'reward') {\n      this.addToast('⭐ Mở phiếu bé ngoan');\n      if (this.featuredEl && this.mainEl) this.mainEl.scrollTo({ top: this.featuredEl.offsetTop - 80, behavior: 'smooth' });\n      return;\n    }\n    const map = { activity: 'KinderCare Schedule.dc.html', health: 'KinderCare Health.dc.html' };\n    if (map[k]) { this.addToast('↗ Mở ' + this.catDefs.find(c => c.key === k).label); setTimeout(() => { window.location.href = map[k]; }, 350); }\n  };\n\n  toggleSidebar = (e) => {\n    if (e) { e.preventDefault(); e.stopPropagation(); }\n    this._collapsed = !this._collapsed;\n    if (typeof document !== 'undefined') document.body.classList.toggle('kc-collapsed', this._collapsed);\n    if (this.sb) this.sb.style.width = this._collapsed ? '88px' : '262px';\n    if (this.mainEl) this.mainEl.style.marginLeft = this._collapsed ? '88px' : '262px';\n  };\n  openRequests = (e) => { if (e) e.preventDefault(); this.setState({ requestsOpen: true }); };\n  closeRequests = () => this.setState({ requestsOpen: false });\n  openAllFns = (e) => { if (e) e.preventDefault(); this.setState({ allFnsOpen: true }); };\n  closeAllFns = () => this.setState({ allFnsOpen: false });\n  goTo = (href) => { this.setState({ allFnsOpen: false }); this.addToast('↗ Đang mở…'); setTimeout(() => { window.location.href = href; }, 300); };\n  resolveRequest = (id) => {\n    const q = this.state.requests.find(x => x.id === id);\n    this.setState(s => ({ requests: s.requests.filter(x => x.id !== id) }));\n    if (q) this.addToast('💬 Đã phản hồi yêu cầu của ' + q.name);\n  };\n\n  handleScan = () => {\n    const i = this.state.queueIdx;\n    if (i >= this.queue.length) { this.addToast('🎉 Đã quét hết hàng chờ trong bản demo'); return; }\n    const k = this.queue[i]; const time = this.now();\n    this.playTing();\n    const id = 'lf' + (this.nid++);\n    this.setState(s => ({ liveFeed: [{ id, name: k.name, time, note: k.note, fresh: true }, ...s.liveFeed], present: s.present + 1, queueIdx: s.queueIdx + 1, scanFlash: true, scanAlert: !!k.note }));\n    this.addToast((k.note ? '⚠️ ' : '✅ ') + k.name + ' đã điểm danh lúc ' + time);\n    setTimeout(() => this.setState({ scanFlash: false, scanAlert: false }), 650);\n  };\n\n  doneMed = (id) => {\n    const m = this.state.medical.find(x => x.id === id);\n    this.setState(s => ({ medical: s.medical.filter(x => x.id !== id) }));\n    if (m) this.addToast('💊 Đã cho ' + m.name + ' uống thuốc');\n  };\n  approveLeave = (id) => {\n    const r = this.state.leaves.find(x => x.id === id);\n    this.setState(s => ({ leaves: s.leaves.map(x => x.id === id ? { ...x, removing: true } : x) }));\n    setTimeout(() => { this.setState(s => ({ leaves: s.leaves.filter(x => x.id !== id), present: Math.max(0, s.present - 1) })); if (r) this.addToast('✅ Đã duyệt đơn nghỉ của ' + r.name); }, 320);\n  };\n\n  starsOf = (k) => k.days + k.meals;\n  eatMeta = (m) => m >= 5 ? { label: 'Ăn hết suất', color: '#0F766E', tint: '#E6F3ED', bd: '#C7E3D5' }\n    : m >= 3 ? { label: 'Ăn khá', color: '#B45309', tint: '#FEF3C7', bd: '#FCD34D' }\n    : { label: 'Cần nhắc ăn', color: '#DC2626', tint: '#FEE2E2', bd: '#FCA5A5' };\n\n  explainKid = (id, e) => {\n    const k = this.state.featured.find(x => x.id === id);\n    if (!k) return;\n    this.addToast('★ ' + this.fn(k.name) + ': ' + k.days + ' ngày đi học + ' + k.meals + ' bữa ăn tốt = ' + this.starsOf(k) + ' sao');\n  };\n\n  awardKid = (id, e, isTop) => {\n    if (e) this.burst(e.clientX, e.clientY, ['#D97706','#FCD34D','#FBBF24','#FDE68A','#F59E0B']);\n    const list = this.state.featured;\n    let kid;\n    if (isTop) { kid = [...list].sort((a, b) => this.starsOf(b) - this.starsOf(a))[0]; id = kid.id; }\n    else kid = list.find(k => k.id === id);\n    this.setState(s => ({ awarded: { ...s.awarded, [id]: true } }));\n    if (kid) this.addToast('🖨️ Đã cấp phiếu bé ngoan cho bé ' + this.fn(kid.name) + ' (' + this.starsOf(kid) + ' sao)');\n    this._aw = this._aw || {};\n    if (this._aw[id]) clearTimeout(this._aw[id]);\n    this._aw[id] = setTimeout(() => this.setState(s => { const a = { ...s.awarded }; delete a[id]; return { awarded: a }; }), 700);\n  };\n\n  toggleNotif = (e) => { if (e) e.stopPropagation(); this.setState(s => ({ notifOpen: !s.notifOpen, avatarOpen: false })); };\n  toggleAvatar = (e) => { if (e) e.stopPropagation(); this.setState(s => ({ avatarOpen: !s.avatarOpen, notifOpen: false })); };\n\n  renderVals() {\n    const s = this.state, av = this.av, fn = this.fn;\n\n    const liveFeed = s.liveFeed.map(it => {\n      const a = av(it.name); const alert = !!it.note;\n      const base = 'display:flex;gap:12px;align-items:flex-start;padding:12px 14px;border-radius:14px;border:1.5px solid ' + (alert ? '#FDA4AF' : '#C7E3D5') + ';background:' + (alert ? '#FFF1F2' : '#F6FAF7') + ';';\n      const anim = it.fresh ? ('animation:kc-slidedown .45s cubic-bezier(.2,.7,.3,1)' + (alert ? ',kc-alertpulse .55s ease 3' : '') + ';') : '';\n      return { id: it.id, name: it.name, time: it.time, note: it.note, hasNote: alert, initial: a.initial, color: a.color, style: base + anim };\n    });\n\n    const cats = this.catDefs.map(c => {\n      const on = s.cat === c.key;\n      return { key: c.key, label: c.label, icon: c.icon, select: () => this.onCat(c.key),\n        style: 'display:inline-flex;align-items:center;gap:9px;height:50px;padding:0 18px 0 10px;border-radius:15px;border:1px solid ' + (on ? c.color : '#E6EEE9') + ';background:' + (on ? c.tint : '#fff') + ';color:' + (on ? c.color : '#374151') + ';font-family:inherit;font-weight:700;font-size:13.5px;cursor:pointer;box-shadow:0 4px 14px -8px rgba(0,90,54,.1);',\n        iconStyle: 'flex:none;width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:15px;background:' + (on ? '#fff' : c.tint) + ';color:' + c.color + ';' };\n    });\n\n    const featuredKids = [...s.featured].sort((a, b) => this.starsOf(b) - this.starsOf(a)).map(k => {\n      const a = av(k.name); const em = this.eatMeta(k.meals);\n      return { id: k.id, name: fn(k.name), initial: a.initial, color: a.color, stars: this.starsOf(k), days: k.days, eatLabel: em.label,\n        justAwarded: !!s.awarded[k.id], award: (e) => this.explainKid(k.id, e),\n        eatStyle: 'display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:' + em.color + ';background:' + em.tint + ';border:1px solid ' + em.bd + ';padding:2px 9px;border-radius:999px;' };\n    });\n\n    // tasks = medical + leave merged with type tags\n    const medTasks = s.medical.map(m => { const a = av(m.name); return {\n      id: m.id, name: m.name, sub: m.med, tag: 'Y tế', initial: a.initial, color: a.color, btn: 'Đã cho uống', action: () => this.doneMed(m.id),\n      tagStyle: 'flex:none;font-size:10px;font-weight:800;color:#DC2626;background:#FEE2E2;padding:1px 7px;border-radius:999px;',\n      btnColor: '#DC2626', btnBorder: '#FECDD3',\n      rowStyle: 'display:flex;gap:11px;align-items:center;' };\n    });\n    const leaveTasks = s.leaves.map(r => { const a = av(r.name); return {\n      id: r.id, name: r.name, sub: r.reason, tag: 'Đơn phép', initial: a.initial, color: a.color, btn: 'Duyệt', action: () => this.approveLeave(r.id),\n      tagStyle: 'flex:none;font-size:10px;font-weight:800;color:#B45309;background:#FEF3C7;padding:1px 7px;border-radius:999px;',\n      btnColor: '#005A36', btnBorder: '#C7E3D5',\n      rowStyle: 'display:flex;gap:11px;align-items:center;' + (r.removing ? 'animation:kc-fadeout .3s forwards;' : '') };\n    });\n    const tasks = [...medTasks, ...leaveTasks];\n\n    let top = s.featured[0];\n    for (const k of s.featured) if (this.starsOf(k) > this.starsOf(top)) top = k;\n    const topA = av(top.name);\n    const topKid = { name: fn(top.name), initial: topA.initial, color: topA.color, stars: this.starsOf(top), days: top.days, meals: top.meals };\n\n    const flashStyle = 'position:absolute;inset:0;border-radius:16px;pointer-events:none;border:4px solid ' + (s.scanAlert ? '#DC2626' : '#005A36') + ';box-shadow:inset 0 0 34px ' + (s.scanAlert ? 'rgba(220,38,38,.45)' : 'rgba(0,90,54,.45)') + ';animation:kc-flash .6s ease;';\n\n    const requests = s.requests.map(q => { const a = av(q.name); return {\n      id: q.id, name: q.name, tag: q.tag, msg: q.msg, initial: a.initial, color: a.color,\n      resolve: () => this.resolveRequest(q.id),\n      tagStyle: 'flex:none;font-size:10px;font-weight:800;color:' + (q.kind === 'pickup' ? '#1D4ED8' : '#B45309') + ';background:' + (q.kind === 'pickup' ? '#E3EDFD' : '#FEF3C7') + ';padding:1px 8px;border-radius:999px;',\n      rowStyle: 'display:flex;gap:12px;align-items:flex-start;padding:13px 14px;border-radius:14px;background:#F8FBF9;border:1px solid #EEF4F0;',\n    }; });\n\n    return {\n      loading: s.loading, present: s.present,\n      presentPct: Math.round(s.present / 42 * 100), remaining: 42 - s.present,\n      toggleSidebar: this.toggleSidebar,\n      setSb: (el) => { this.sb = el; }, setMainEl: (el) => { this.mainEl = el; },\n      requestsOpen: s.requestsOpen, openRequests: this.openRequests, closeRequests: this.closeRequests,\n      requests, requestCount: s.requests.length, noRequests: s.requests.length === 0,\n      allFnsOpen: s.allFnsOpen, openAllFns: this.openAllFns, closeAllFns: this.closeAllFns,\n      allFns: [\n        { key: 'attend', label: 'Điểm danh QR', icon: '✓', color: '#005A36', tint: '#E6F3ED', action: () => { this.setState({ allFnsOpen: false, scannerOpen: true }); } },\n        { key: 'class', label: 'Danh sách lớp', icon: '👥', color: '#2563EB', tint: '#E3EDFD', action: () => this.goTo('KinderCare Class Redesign v2.dc.html') },\n        { key: 'profile', label: 'Hồ sơ bé', icon: '🧒', color: '#0EA5E9', tint: '#E0F2FE', action: () => this.goTo('KinderCare Class.dc.html') },\n        { key: 'schedule', label: 'Thực đơn & Lịch học', icon: '📅', color: '#7C3AED', tint: '#F1ECFE', action: () => this.goTo('KinderCare Schedule.dc.html') },\n        { key: 'lesson', label: 'Soạn giáo án', icon: '📝', color: '#0F766E', tint: '#D9F2EC', action: () => this.goTo('KinderCare Lesson Plan.dc.html') },\n        { key: 'health', label: 'Y tế & Sức khỏe', icon: '💊', color: '#DC2626', tint: '#FEE2E2', action: () => this.goTo('KinderCare Health.dc.html') },\n        { key: 'reward', label: 'Phiếu bé ngoan', icon: '⭐', color: '#D97706', tint: '#FEF3C7', action: () => { this.setState({ allFnsOpen: false }); this.addToast('⭐ Mở phiếu bé ngoan'); } },\n        { key: 'requests', label: 'Yêu cầu phụ huynh', icon: '💬', color: '#8B5CF6', tint: '#F1ECFE', action: () => this.setState({ allFnsOpen: false, requestsOpen: true }) },\n        { key: 'settings', label: 'Hồ sơ & Cài đặt', icon: '⚙️', color: '#475569', tint: '#EEF2F6', action: () => this.goTo('KinderCare Profile Bento.dc.html') },\n      ],\n      scannerOpen: s.scannerOpen, openScanner: this.openScanner, closeScanner: this.closeScanner, stop: this.stop,\n      liveFeed, feedCount: s.liveFeed.length,\n      cats, featuredKids, tasks, noTasks: tasks.length === 0, topKid,\n      awardTop: (e) => this.awardKid(null, e, true),\n      scanFlash: s.scanFlash, flashStyle,\n      onScan: this.handleScan,\n      onManual: () => this.addToast('📝 Mở danh sách điểm danh thủ công…'),\n      onSwitchCam: () => this.addToast('🔄 Đã chuyển camera trước / sau'),\n      toasts: s.toasts,\n      notifOpen: s.notifOpen, avatarOpen: s.avatarOpen, toggleNotif: this.toggleNotif, toggleAvatar: this.toggleAvatar,\n      setConfetti: (el) => { this.confetti = el; },\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"